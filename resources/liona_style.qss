/*
 * Liona Term - application stylesheet
 * Minimal dark theme for Qt Widgets.
 *
 * Intentionally does not style QTermWidget so terminal color schemes
 * remain controlled by QTermWidget itself.
 */

/* ---------- Base ---------- */

QMainWindow {
    background: #151515;
}

QWidget {
    color: #d0d0d0;
}

QToolTip {
    background: #252525;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    padding: 4px 6px;
}


/* ---------- Main splitter ---------- */

QSplitter {
    background: #151515;
}

QSplitter::handle {
    background: #2a2a2a;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}


/* ---------- File explorer ---------- */

LionaFileExplorer {
    background: #181818;
}

LionaFileExplorer QLineEdit {
    min-height: 28px;
    background: #181818;
    color: #cfcfcf;

    border: none;
    border-bottom: 1px solid #303030;

    padding: 2px 8px;

    selection-background-color: #3d3d3d;
    selection-color: #ffffff;
}

LionaFileExplorer QLineEdit:hover {
    background: #1c1c1c;
}

LionaFileExplorer QLineEdit:focus {
    background: #1c1c1c;
    border-bottom: 1px solid #686868;
}

LionaFileExplorer QLineEdit[invalid="true"] {
    color: #ff7b72;
    border-bottom: 1px solid #b34d48;
}

LionaFileExplorer QTreeView {
    background: #181818;
    alternate-background-color: #181818;
    color: #c8c8c8;

    border: none;
    outline: none;

    padding-top: 3px;

    selection-background-color: #303030;
    selection-color: #ffffff;
}

LionaFileExplorer QTreeView::item {
    min-height: 25px;
    border: none;
    padding-left: 2px;
}

LionaFileExplorer QTreeView::item:hover {
    background: #242424;
    color: #e2e2e2;
}

LionaFileExplorer QTreeView::item:selected {
    background: #303030;
    color: #ffffff;
}

LionaFileExplorer QTreeView::item:selected:!active {
    background: #292929;
    color: #e0e0e0;
}


/* ---------- Terminal tabs ---------- */

LionaTab {
    background: #000000;
}

LionaTab::pane {
    border: 1px solid #000000;
    background: #000000;
}

LionaTab::tab-bar:top {
    top: 1px;
}

LionaTab QTabBar {
    background: #e7e7e9;
    border: none;
}

LionaTab QTabBar::tab {
    min-width: 16ex;
    color: #202020;
    border: 1px solid #000000;
    padding: 5px 10px;
    margin-right: -1px;
}

LionaTab QTabBar::tab:!selected {
    background: silver;
    margin-top: 3px;
}

LionaTab QTabBar::tab:!selected:hover {
    background: #999999;
}

LionaTab QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: transparent;
}

LionaTab QTabBar::tab:last,
LionaTab QTabBar::tab:only-one {
    margin-right: 0;
}

LionaTab QTabBar::close-button {
    subcontrol-position: right;
    margin-left: 5px;
}

LionaTab QToolButton {
    min-width: 28px;
    min-height: 28px;

    background: transparent;
    color: #303030;

    border: none;
    padding: 0 7px;
}

LionaTab QToolButton:hover {
    background: #d2d2d5;
    color: #111111;
    border-radius: 6px;
}

LionaTab QToolButton:pressed {
    background: #c4c4c8;
}


/* ---------- Menus ---------- */

QMenu {
    background: #202020;
    color: #d6d6d6;

    border: 1px solid #363636;
    padding: 4px;
}

QMenu::item {
    min-height: 22px;
    padding: 3px 24px 3px 9px;
    border-radius: 3px;
}

QMenu::item:selected {
    background: #343434;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #666666;
}

QMenu::separator {
    height: 1px;
    background: #383838;
    margin: 4px 6px;
}


/* ---------- Scroll bars ---------- */

QScrollBar:vertical {
    width: 10px;
    margin: 0;
    background: #181818;
    border: none;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #3a3a3a;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #505050;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
    background: #181818;
    border: none;
}

QScrollBar::handle:horizontal {
    min-width: 28px;
    background: #3a3a3a;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #505050;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ---------- Dialogs used by the app ---------- */

QFileDialog,
QMessageBox {
    background: #1b1b1b;
}

QFileDialog QLineEdit,
QMessageBox QLabel {
    color: #d8d8d8;
}

QPushButton {
    min-height: 26px;
    background: #2a2a2a;
    color: #dddddd;

    border: 1px solid #3a3a3a;
    border-radius: 3px;

    padding: 2px 10px;
}

QPushButton:hover {
    background: #343434;
    border-color: #4a4a4a;
}

QPushButton:pressed {
    background: #242424;
}
